{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SkyFlow Designer",
  "version": "1.0.0",
  "identifier": "com.skyflow.designer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SkyFlow Designer",
        "width": 1600,
        "height": 950,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "dragDropEnabled": true,
        "zoomHotkeysEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "MIT",
    "category": "GraphicsAndDesign",
    "shortDescription": "天空盒流动贴图设计工具",
    "longDescription": "专业工具，用于创建动态天空盒流动贴图（Flowmaps）。支持导入天空纹理、实时绘制流向矢量，并在 3D 场景中即时预览动画效果。"
  }
}
